{
  "name": "@alpha/ui-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Typed generated-UI bridge protocol (contract 0.2): host side for the trusted shell, client side for unprivileged generated UI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@alpha/contracts": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
