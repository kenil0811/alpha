{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "Clause": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Clause",
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "lte",
        "gt",
        "gte",
        "in",
        "contains",
        "starts_with",
        "is_null"
      ],
      "title": "FilterOp",
      "type": "string"
    },
    "InvokeStep": {
      "additionalProperties": false,
      "description": "Run one declared action through the platform and check its outcome.",
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "exact": {
          "default": false,
          "type": "boolean"
        },
        "expect": {
          "default": "succeeded",
          "enum": [
            "succeeded",
            "failed"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "type": "object"
        },
        "kind": {
          "const": "invoke",
          "default": "invoke",
          "type": "string"
        },
        "model": {
          "default": "normal",
          "enum": [
            "normal",
            "unavailable",
            "malformed",
            "timeout"
          ],
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "InvokeStep",
      "type": "object"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clause"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ]
        }
      },
      "required": [
        "not"
      ],
      "title": "Not",
      "type": "object"
    },
    "RecordsStep": {
      "additionalProperties": false,
      "description": "Read the preview store directly (never through the candidate) and check what persisted.",
      "properties": {
        "collection": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "includes": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "kind": {
          "const": "records",
          "default": "records",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clause"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "collection"
      ],
      "title": "RecordsStep",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "invoke": "#/$defs/InvokeStep",
                "records": "#/$defs/RecordsStep"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InvokeStep"
              },
              {
                "$ref": "#/$defs/RecordsStep"
              }
            ]
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "steps"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "UiPlan": {
      "additionalProperties": false,
      "description": "The screen's primary interaction and what it must visibly and durably do.",
      "properties": {
        "primary": {
          "items": {
            "$ref": "#/$defs/UiStep"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "saved": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordsStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "items": {
            "$ref": "#/$defs/InvokeStep"
          },
          "maxItems": 20,
          "type": "array"
        },
        "seed_shows": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "shows": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "required": [
        "primary"
      ],
      "title": "UiPlan",
      "type": "object"
    },
    "UiStep": {
      "additionalProperties": false,
      "description": "One user action on the rendered screen, addressed the way a person would: by the visible\nlabel of a field or the name of a button.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "fill",
            "press",
            "click",
            "select",
            "check"
          ],
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "UiStep",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.2",
      "default": "0.2",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scenarios"
  ],
  "title": "ValidationPlan",
  "type": "object",
  "x-alpha-contract-version": "0.2"
}
