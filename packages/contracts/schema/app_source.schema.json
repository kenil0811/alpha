        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
