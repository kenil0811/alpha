{
  "$defs": {
    "ActionBinding": {
      "additionalProperties": false,
      "description": "Run `action` with the record id as `id_param`, plus `input` and what the block adds.",
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "confirm": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id_param": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionBinding",
      "type": "object"
    },
    "ActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "capability_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "effect_class": {
          "$ref": "#/$defs/EffectClass",
          "default": "none"
        },
        "handler": {
          "maxLength": 200,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "type": "object"
        },
        "invocable_from": {
          "items": {
            "$ref": "#/$defs/Invocable"
          },
          "minItems": 1,
          "type": "array"
        },
        "output_schema": {
          "additionalProperties": true,
          "type": "object"
        },
        "retry_class": {
          "$ref": "#/$defs/RetryClass",
          "default": "pure"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "handler",
        "input_schema",
        "output_schema",
        "invocable_from"
      ],
      "title": "ActionDefinition",
      "type": "object"
    },
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
