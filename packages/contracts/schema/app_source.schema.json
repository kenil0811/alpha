{
  "$defs": {
    "ActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "capability_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "effect_class": {
          "$ref": "#/$defs/EffectClass",
          "default": "none"
        },
        "handler": {
          "maxLength": 200,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "type": "object"
        },
        "invocable_from": {
          "items": {
            "$ref": "#/$defs/Invocable"
          },
          "minItems": 1,
          "type": "array"
        },
        "output_schema": {
          "additionalProperties": true,
          "type": "object"
        },
        "retry_class": {
          "$ref": "#/$defs/RetryClass",
          "default": "pure"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "handler",
        "input_schema",
        "output_schema",
        "invocable_from"
      ],
      "title": "ActionDefinition",
      "type": "object"
    },
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "Bucket": {
      "enum": [
        "day",
        "week",
        "month"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Clause": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Clause",
      "type": "object"
    },
    "CollectionSchema": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 500,
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "indexes": {
          "items": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 8,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "unique": {
          "items": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 4,
          "type": "array"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "title": "CollectionSchema",
      "type": "object"
    },
    "EffectClass": {
      "enum": [
        "none",
        "local_write",
        "external_read",
        "external_write"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "FieldKind": {
      "enum": [
        "text",
        "number",
        "integer",
        "boolean",
        "date",
        "datetime",
        "choice",
        "reference",
        "json"
      ],
      "title": "FieldKind",
      "type": "string"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "description": "One declared field. Bounds default to platform policy when omitted.",
      "properties": {
        "choices": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collection": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldKind"
        },
        "max_bytes": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_length": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "lte",
        "gt",
        "gte",
        "in",
        "contains",
        "starts_with",
        "is_null"
      ],
      "title": "FilterOp",
      "type": "string"
    },
    "GroupKey": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field"
      ],
      "title": "GroupKey",
      "type": "object"
    },
    "Invocable": {
      "enum": [
        "assistant",
        "ui",
        "manual",
        "trigger"
      ],
      "title": "Invocable",
      "type": "string"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fn": {
          "$ref": "#/$defs/MetricFn"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "fn"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricFn": {
      "enum": [
        "count",
        "sum",
        "avg",
        "min",
        "max"
      ],
      "title": "MetricFn",
      "type": "string"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clause"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ]
        }
      },
      "required": [
        "not"
      ],
      "title": "Not",
      "type": "object"
    },
    "RetryClass": {
      "enum": [
        "pure",
        "idempotent",
        "requires_reconciliation"
      ],
      "title": "RetryClass",
      "type": "string"
    },
    "SortKey": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string"
        },
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "SortKey",
      "type": "object"
    },
    "UiDeclaration": {
      "additionalProperties": false,
      "description": "What an App's custom UI may read and do. It carries no native privileges; the shell derives\nthe bridge grant from it and Core enforces the views.",
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "bridge_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "build_profile": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entry": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kit_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "views": {
          "items": {
            "$ref": "#/$defs/ViewSpec"
          },
          "maxItems": 32,
          "type": "array"
        }
      },
      "title": "UiDeclaration",
      "type": "object"
    },
    "ViewKind": {
      "enum": [
        "records",
        "aggregate"
      ],
      "title": "ViewKind",
      "type": "string"
    },
    "ViewSpec": {
      "additionalProperties": false,
      "description": "A bounded read view the App's UI may query (App UI Bridge, records.query). The view fixes\nthe collection, an optional base filter, the projection and limits; the UI can only narrow it\nwith filters on `filterable` fields and sort on `sortable` fields.",
      "properties": {
        "collection": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "default_order": {
          "items": {
            "$ref": "#/$defs/SortKey"
          },
          "maxItems": 3,
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "type": "string"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filterable": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "group_by": {
          "items": {
            "$ref": "#/$defs/GroupKey"
          },
          "maxItems": 3,
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ViewKind",
          "default": "records"
        },
        "max_limit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "maxItems": 8,
          "type": "array"
        },
        "sortable": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "where": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clause"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "collection"
      ],
      "title": "ViewSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionDefinition"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "app_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,63}$",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "collections": {
      "items": {
        "$ref": "#/$defs/CollectionSchema"
      },
      "maxItems": 32,
      "type": "array"
    },
    "config_schema": {
      "additionalProperties": true,
      "type": "object"
    },
    "contract_version": {
      "const": "0.2",
      "type": "string"
    },
    "description": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "modules": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "primary_action": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_profile": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "sdk_version": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    },
    "trigger_templates": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiDeclaration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract_version",
    "app_id",
    "name",
    "description",
    "runtime_profile",
    "sdk_version",
    "actions"
  ],
  "title": "AppSource",
  "type": "object",
  "x-alpha-contract-version": "0.2"
}
