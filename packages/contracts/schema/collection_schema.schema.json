{
  "$defs": {
    "FieldKind": {
      "enum": [
        "text",
        "long_text",
        "number",
        "integer",
        "boolean",
        "date",
        "datetime",
        "choice",
        "status",
        "multiselect",
        "url",
        "reference",
        "relation",
        "json"
      ],
      "title": "FieldKind",
      "type": "string"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "description": "One declared field. Bounds default to platform policy when omitted.",
      "properties": {
        "choices": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collection": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "type": "string"
        },
        "done_choices": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/FieldKind"
        },
        "max_bytes": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_length": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "PageSpec": {
      "additionalProperties": false,
      "description": "How the collection's derived page opens. Every collection gets a page (table first,\nwith the other views a click away); this only sets the starting point and what to hide.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,47}$",
                "type": "string"
              },
              "maxItems": 24,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date_field": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_field": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quick_entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuickEntrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "view": {
          "default": "table",
          "enum": [
            "table",
            "board",
            "list",
            "calendar",
            "chart"
          ],
          "type": "string"
        }
      },
      "title": "PageSpec",
      "type": "object"
    },
    "QuickEntrySpec": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "input": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "placeholder": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "input",
        "placeholder"
      ],
      "title": "QuickEntrySpec",
      "type": "object"
    },
    "SortKey": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string"
        },
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "SortKey",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "maxLength": 500,
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "indexes": {
      "items": {
        "items": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "type": "array"
      },
      "maxItems": 8,
      "type": "array"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "type": "string"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "title_field": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unique": {
      "items": {
        "items": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        },
        "type": "array"
      },
      "maxItems": 4,
      "type": "array"
    }
  },
  "required": [
    "name",
    "fields"
  ],
  "title": "CollectionSchema",
  "type": "object",
  "x-alpha-contract-version": "0.2"
}
