{
  "$defs": {
    "PackageFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "PackageFile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "package.index.json: platform-produced digests of every sealed file plus the identities\nthe Version was validated against. `package_sha256` is the canonical digest of the rest.",
  "properties": {
    "app_id": {
      "type": "string"
    },
    "contract_version": {
      "const": "0.2",
      "default": "0.2",
      "type": "string"
    },
    "dependency_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackageFile"
      },
      "type": "array"
    },
    "package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "toolchain": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "app_id",
    "files",
    "dependency_manifest_sha256",
    "toolchain",
    "package_sha256"
  ],
  "title": "PackageIndex",
  "type": "object",
  "x-alpha-contract-version": "0.2"
}
