{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Clause"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "Bucket": {
      "enum": [
        "day",
        "week",
        "month"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Clause": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Clause",
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "lte",
        "gt",
        "gte",
        "in",
        "contains",
        "starts_with",
        "is_null"
      ],
      "title": "FilterOp",
      "type": "string"
    },
    "GroupKey": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field"
      ],
      "title": "GroupKey",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fn": {
          "$ref": "#/$defs/MetricFn"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "fn"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricFn": {
      "enum": [
        "count",
        "sum",
        "avg",
        "min",
        "max"
      ],
      "title": "MetricFn",
      "type": "string"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clause"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ]
        }
      },
      "required": [
        "not"
      ],
      "title": "Not",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection": {
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "type": "string"
    },
    "group_by": {
      "items": {
        "$ref": "#/$defs/GroupKey"
      },
      "maxItems": 3,
      "type": "array"
    },
    "limit": {
      "default": 100,
      "minimum": 1,
      "type": "integer"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "where": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clause"
        },
        {
          "$ref": "#/$defs/AllOf"
        },
        {
          "$ref": "#/$defs/AnyOf"
        },
        {
          "$ref": "#/$defs/Not"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "collection",
    "metrics"
  ],
  "title": "AggregateQuery",
  "type": "object",
  "x-alpha-contract-version": "0.2"
}
