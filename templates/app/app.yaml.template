contract_version: "0.2"
app_id: "{{APP_ID}}"
name: "{{APP_NAME}}"
description: "{{ONE_SENTENCE_PURPOSE}}"
runtime_profile: "{{RUNTIME_PROFILE}}"
sdk_version: "{{SDK_VERSION}}"
capabilities: [records]
primary_action: add_item   # the action a person runs from the assistant or by hand
collections:
  - name: items
    title_field: title
    fields:
      - {name: title, kind: text, required: true, max_length: 200}
      - {name: noted_on, kind: date, required: true}
    page:
      sort: {field: noted_on, direction: desc}
      quick_entry: {action: add_item, input: title, placeholder: "Add an item"}
actions:
  - id: add_item
    title: Add an item
    description: Create one item dated today.
    handler: app_code.handlers:add_item
    invocable_from: [ui, assistant, manual]
    effect_class: local_write
    capability_requirements: [records]
    input_schema:
      type: object
      required: [title]
      additionalProperties: false
      properties: {title: {type: string, minLength: 1}}
    output_schema:
      type: object
      required: [id, revision]
      properties: {id: {type: string}, revision: {type: integer}, message: {type: string}}
# Declared read views: what the screen (and any custom ui) may read. Core enforces them.
views:
  - id: items.recent
    collection: items
    filterable: [title, noted_on]
    sortable: [title, noted_on, created_at]
    default_order: [{field: created_at, direction: desc}]
    max_limit: 100
# Every collection is a page Alpha draws (table first, board/list/calendar/chart a click away).
# `summary:` cards make the Summary tab (see APP_CONTRACT.md); a `screen:` is only for tabs a
# derived page cannot give.
summary: []
