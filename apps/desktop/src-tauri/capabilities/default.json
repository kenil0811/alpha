{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted shell windows: typed host commands only, plus dragging the avatar.",
  "windows": ["main", "avatar"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "dialog:allow-open"
  ]
}
